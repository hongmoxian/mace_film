#!/bin/bash
# FeN4 MACE-FiLM PES training: AIMD(stride10) + opt scan data.
# Uses rebuilt previous-magnetic-moment inputs, ZBL, and bounded element-aware FiLM.

#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=3
#SBATCH -N 1
#SBATCH --gres=gpu:1
#SBATCH -J fen4_mace_opt_bfilm
#SBATCH --partition=8v100
#SBATCH -o /home/wuzhihong/software/ocp_mag/work_fen4_escn_zbl_mdtest/mace_film/slurm-optpes-zbl-bfilm-elem8-%j.out

set -euo pipefail

export PYTHONPATH=/home/wuzhihong/software/mace:/home/wuzhihong/software/ocp_mag/work_fen4_escn_zbl_mdtest/mace_film:${PYTHONPATH:-}
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR=/tmp/matplotlib-${USER:-wuzhihong}
mkdir -p "${MPLCONFIGDIR}"

PY=/home/wuzhihong/app/miniconda/envs/mace/bin/python
BUILDPY=/home/wuzhihong/app/miniconda/envs/fairchem-q/bin/python
WORK=/home/wuzhihong/software/ocp_mag/work_fen4_escn_zbl_mdtest/mace_film
PTCACHE=/home/wuzhihong/software/ocp_mag/data/fe_o2_scan_initial_fixbond_opt/joint_singlehead_aimd_opt_s2magmomonly_s0clean_pt_cache
LINREF=${PTCACHE}/atomic_energy_linref.json
DATA=${WORK}/data/fen4_aimd10_opt_pes_previous_rebuilt.extxyz
SAVE=${WORK}/checkpoints/fen4_mace_magmom_film_aimd10_opt_pes_zbl_bounded_elem8_v1
REBUILD_DATA=${REBUILD_DATA:-0}

mkdir -p "${WORK}/data" "${WORK}/checkpoints"

if [[ ! -s "${PTCACHE}/cache_metadata.json" ]]; then
  echo "Missing PT cache metadata: ${PTCACHE}/cache_metadata.json" >&2
  exit 1
fi
if [[ ! -s "${LINREF}" ]]; then
  echo "Missing atomic energy linref: ${LINREF}" >&2
  exit 1
fi

if [[ "${REBUILD_DATA}" = "1" || ! -s "${DATA}" ]]; then
  "${BUILDPY}" "${WORK}/build_mace_extxyz_from_pt_cache.py" \
    --pt-cache "${PTCACHE}" \
    --output "${DATA}" \
    --rebuild-previous-inmag
fi

"${PY}" "${WORK}/train_fen4_mace_magmom_film.py" \
  --extxyz "${DATA}" \
  --save-dir "${SAVE}" \
  --batch-size 4 \
  --num-workers 2 \
  --max-epochs 30 \
  --lr 1e-3 \
  --cutoff 5.0 \
  --train-fraction 0.8 \
  --val-fraction 0.1 \
  --test-fraction 0.1 \
  --energy-w 1 \
  --force-w 100 \
  --magmom-w 10 \
  --total-magmom-w 1 \
  --loss-type l1 \
  --max-initial-equals-target-fraction 0.06 \
  --atomic-energy-linref "${LINREF}" \
  --hidden-irreps '128x0e + 128x1o' \
  --num-interactions 2 \
  --max-ell 3 \
  --correlation 3 \
  --film-scale 0.1 \
  --film-use-tanh \
  --magmom-input-clip 2.0 \
  --film-element-embedding-dim 8 \
  --device cuda \
  --use-zbl
